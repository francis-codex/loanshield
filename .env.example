# firebase web config (firebase console > project settings > your apps). these are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# app check (recaptcha enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_KEY=
# local dev only: app check debug token registered in the firebase console
VITE_APPCHECK_DEBUG=
# cloud model for complaint drafting
VITE_CLOUD_MODEL=gemini-3.5-flash
